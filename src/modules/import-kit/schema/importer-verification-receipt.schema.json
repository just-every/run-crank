{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runeditrun.com/schemas/import-kit/importer-verification-receipt-v1.schema.json",
  "title": "Signed real-export importer verification receipt",
  "type": "object",
  "required": ["schemaVersion", "type", "keyId", "algorithm", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "runeditrun.importer-verification-receipt" },
    "keyId": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "Ed25519" },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": {
      "type": "string",
      "description": "Base64 Ed25519 signature over UTF-8 canonical JSON of payload, with object keys sorted recursively.",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "required": ["input", "unique", "duplicates", "mapped", "unmapped", "rejected", "effects", "byKind"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "unique": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "effects": { "type": "integer", "minimum": 0 },
        "byKind": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "manifestComparison": {
      "type": "object",
      "required": ["sourceCount", "targetCount", "sourceManifestSha256", "targetManifestSha256"],
      "properties": {
        "sourceCount": { "type": "integer", "minimum": 0 },
        "targetCount": { "type": "integer", "minimum": 0 },
        "sourceManifestSha256": { "$ref": "#/$defs/hash" },
        "targetManifestSha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "incumbent", "product", "synthetic", "source", "candidate", "adapter",
        "mapping", "command", "runs", "reconciliation", "unmapped", "research", "review"
      ],
      "properties": {
        "incumbent": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "synthetic": { "const": false },
        "source": {
          "type": "object",
          "required": ["classification", "origin", "exportedAt", "format", "version", "sha256", "size"],
          "properties": {
            "classification": { "const": "authorized-real-export" },
            "origin": { "type": "string", "minLength": 1 },
            "exportedAt": { "$ref": "#/$defs/timestamp" },
            "format": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/hash" },
            "size": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": ["repository", "revision"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "revision": { "$ref": "#/$defs/revision" }
          },
          "additionalProperties": false
        },
        "adapter": {
          "type": "object",
          "required": ["repository", "revision"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "revision": { "$ref": "#/$defs/revision" }
          },
          "additionalProperties": false
        },
        "mapping": {
          "type": "object",
          "required": ["version", "policy", "policySha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "policy": { "type": "string", "minLength": 1 },
            "policySha256": { "$ref": "#/$defs/hash" }
          },
          "additionalProperties": false
        },
        "command": { "type": "string", "minLength": 1 },
        "runs": {
          "type": "object",
          "required": ["dryRun", "apply"],
          "properties": {
            "dryRun": { "$ref": "#/$defs/counts" },
            "apply": { "$ref": "#/$defs/counts" }
          },
          "additionalProperties": false
        },
        "reconciliation": {
          "type": "object",
          "required": ["rows", "provenance", "attachments"],
          "properties": {
            "rows": { "$ref": "#/$defs/manifestComparison" },
            "provenance": { "$ref": "#/$defs/manifestComparison" },
            "attachments": { "$ref": "#/$defs/manifestComparison" }
          },
          "additionalProperties": false
        },
        "unmapped": {
          "type": "object",
          "required": ["count", "itemManifestSha256", "items"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "itemManifestSha256": { "$ref": "#/$defs/hash" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceIdentitySha256", "sourceKind", "fields"],
                "properties": {
                  "sourceIdentitySha256": { "$ref": "#/$defs/hash" },
                  "sourceKind": { "type": "string", "minLength": 1 },
                  "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "research": {
          "type": "object",
          "required": ["state", "sha256"],
          "properties": {
            "state": { "const": "finished" },
            "sha256": { "$ref": "#/$defs/hash" }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": ["reviewer", "reviewedAt", "result"],
          "properties": {
            "reviewer": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$" },
            "reviewedAt": { "$ref": "#/$defs/timestamp" },
            "result": { "const": "passed" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
