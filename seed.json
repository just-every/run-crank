{
  "id": "crank",
  "name": "Crank",
  "version": "0.1.0",
  "maturity": "first-release-candidate",
  "category": "automation",
  "spine": {
    "id": "workflow",
    "record": "An immutable event-to-action run"
  },
  "description": "Workflow automation: published workflows run unattended from triggers, with managed connections, a connector catalogue (Slack and generic HTTP today) and optional approval steps.",
  "capabilities": [
    {
      "id": "http-dispatch",
      "clauses": [
        "HTTP-001"
      ]
    }
  ],
  "nonGoals": [
    "Unapproved agent actions"
  ],
  "externals": [
    {
      "id": "cloudflare",
      "required": true,
      "why": "Worker hosting",
      "data": [
        "HTTP requests"
      ],
      "adapters": []
    }
  ],
  "env": [],
  "deploy": {
    "healthPath": "/health",
    "publicPaths": [
      "/",
      "/health",
      "/signin"
    ],
    "notes": "Native owner sessions guard /app; unknown paths return real 404s; the development outbox is local-only."
  },
  "extensionPoints": {
    "contributions": [],
    "policies": [],
    "events": [],
    "slots": [],
    "adapters": []
  },
  "limits": {
    "status": "unmeasured"
  },
  "accessibility": {
    "level": "WCAG 2.2 AA",
    "status": "target; unaudited"
  },
  "operatingCost": {
    "status": "unmeasured"
  },
  "composition": {
    "base": "base",
    "family": "automation",
    "edition": "crank",
    "modules": [
      "job-queue",
      "release",
      "deploy-kit",
      "container",
      "demo-host",
      "integrations",
      "mail",
      "ai",
      "portability",
      "erasure",
      "dependencies",
      "operator-auth",
      "owner-claim"
    ]
  }
}
