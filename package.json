{
  "name": "@automation/crank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "rer queue test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "test:email-link": "rer queue test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "rer queue verify:app -- sh -c \"pnpm run build && pnpm run typecheck && pnpm run test:crank && pnpm run test:runtime && pnpm run test:email-link\"",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "outbox": "rer outbox",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:crank": "node --test --test-concurrency=1 tests/crank.test.mjs",
    "inbox": "node examples/inbox/server.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.17",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260907.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
